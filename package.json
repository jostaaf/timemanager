{
  "name": "timemanager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:init": "python3 scripts/initialize-database.py",
    "db:types": "python3 scripts/generate-db-types.py",
    "build": "npm run db:types && tsc",
    "check": "npm run db:types && tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "api:start": "npm run build && node dist/server/http/main.js",
    "i18n:extract": "xgettext --language=JavaScript --from-code=UTF-8 --keyword=_ --keyword=ngettext:1,2 --output=po/timemanager.pot src/client/main.js src/client/contacts-api.js",
    "i18n:compile": "python3 scripts/compile-translations.py",
    "client:gnome": "npm run build && npm run i18n:compile && env -u GIO_MODULE_DIR gjs -m src/client/main.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3"
  }
}
